# Copia este fichero como .env y rellénalo. NUNCA subas el .env a git.

# Cookie de HoYoLAB (ver README): "ltuid_v2=...; ltoken_v2=..."
HOYOLAB_COOKIE=ltuid_v2=PEGA_AQUI; ltoken_v2=PEGA_AQUI

# Juegos separados por espacio: gi (Genshin), hsr (Star Rail), zzz (Zenless)
GAMES=gi hsr zzz

# Idioma de los mensajes de HoYoLAB
HOYOLAB_LANG=es-es

# Espera aleatoria al arrancar, en segundos (0 = ninguna). Útil con cron
# para no ejecutar siempre al segundo exacto.
START_JITTER_SECONDS=300

# Opcional: guardar también el log en un fichero
# LOG_FILE=./logs/checkin.log
