# Copia este fichero como .env en la carpeta del NAS y rellénalo. NUNCA subas el .env a git.
# Tras cambiarlo, reinicia el proyecto en UGOS (Docker → Proyectos → hoyo-games → ⋯ → Reiniciar).

# Cookie de hoyolab.com para el check-in (ver README): "ltuid_v2=...; ltoken_v2=..."
HOYOLAB_COOKIE=ltuid_v2=PEGA_AQUI; ltoken_v2=PEGA_AQUI

# Cookie de hoyoverse.com para canjear códigos (ver README): "account_id_v2=...; account_mid_v2=...; cookie_token_v2=..."
# Sin ella, el panel enseña los códigos pero no los canjea.
HOYOVERSE_REDEEM_COOKIE=account_id_v2=PEGA_AQUI; account_mid_v2=PEGA_AQUI; cookie_token_v2=PEGA_AQUI

# UID de tu personaje en cada juego (sale en el perfil del juego). Sin UID, ese juego no canjea.
GI_UID=
HSR_UID=
ZZZ_UID=

# Juegos separados por espacio: gi (Genshin), hsr (Star Rail), zzz (Zenless)
GAMES=gi hsr zzz

# Idioma de los mensajes y recompensas de HoYoLAB
HOYOLAB_LANG=es-es

# Espera aleatoria antes del check-in de las 19:00, en segundos (0 = ninguna)
START_JITTER_SECONDS=300

# Contraseña del panel. Sin ella, cualquiera de tu wifi puede verlo y lanzar el check-in.
WEB_PASSWORD=
